      "item": [
        {
          "name": "Auth Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/test"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Auth test returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login?username={{adminUsername}}&password={{adminPassword}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const token = pm.response.text().replace(/\\\"/g, '').trim();",
                  "pm.environment.set('adminToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
